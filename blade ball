-- Variáveis de Controle
local AutoParryEnabled = false
local AutoSpamEnabled = false
local DistanceThreshold = 15
local SpamDistance = 10

local Tab = Window:CreateTab("Principal", 4483362458)
local CombatTab = Window:CreateTab("Combate", 4483362458)

-- Lógica do Script (Parry & Spam)
task.spawn(function()
    while task.wait() do
        local char = game.Players.LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        for _, ball in pairs(game.Workspace.Balls:GetChildren()) do
            if ball:FindFirstChild("zoomies") then
                local ballDist = (ball.Position - hrp.Position).Magnitude
                local velocity = ball.Velocity.Magnitude
                
                -- Lógica de Spam (Duelo de curta distância)
                if AutoSpamEnabled and ballDist <= SpamDistance then
                    game:GetService("ReplicatedStorage").Remotes.Parry:FireServer()
                
                -- Lógica de Auto-Parry (Rebate automático)
                elseif AutoParryEnabled then
                    local dynamicDist = DistanceThreshold + (velocity * 0.1)
                    if ballDist <= dynamicDist then
                        game:GetService("ReplicatedStorage").Remotes.Parry:FireServer()
                    end
                end
            end
        end
    end
end)

